# Prod: standalone SSR (next.config.js: output standalone)
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# rewrites (/backend/*) и NEXT_PUBLIC_* запекаются в next build —
# рантайм-ENV их не меняет, поэтому тянем build-args (см. compose).
# Дефолта нет: значение только из env; пустое допустимо — фронт возьмёт живой /public/config.
ARG BACKEND_URL=http://gateway:8080
ARG NEXT_PUBLIC_MAIL_DOMAIN
ENV BACKEND_URL=$BACKEND_URL NEXT_PUBLIC_MAIL_DOMAIN=$NEXT_PUBLIC_MAIL_DOMAIN
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
