# Домен своих ящиков. Регистрация username+password -> username@MAIL_DOMAIN
# ВНИМАНИЕ: это только сид при ПЕРВОМ старте (таблица system_settings, V8).
# Дальше домен и алиасы меняются вживую в /admin → Настройки, без пересборки.
MAIL_DOMAIN=corp-sec.ru

# PostgreSQL
POSTGRES_DB=safemail
POSTGRES_USER=safemail
POSTGRES_PASSWORD=safemail
DATABASE_URL=jdbc:postgresql://postgres:5432/safemail

# Порты SMTP-шлюза (внутри контейнера gateway)
SMTP_PORT=2525
SMTP_HOST=0.0.0.0
# Внешняя отправка (relay). Для MVP — MailHog-подобный фейк или реальный relay
MAIL_RELAY_HOST=mailhog
MAIL_RELAY_PORT=1025
# ВНИМАНИЕ (прод): замените на реальный SMTP relay, иначе чистая почта
# никуда не уйдёт (без relay доставка падает в FAILED).
# Пример: MAIL_RELAY_HOST=smtp.your-provider.ru / MAIL_RELAY_PORT=587

# Python-микросервисы (внутри docker-сети)
PARSER_URL=http://ml-parser:8001
ENRICH_URL=http://ml-enrich:8002
CLASSIFY_URL=http://ml-classify:8003

# LLM для семантики ml-classify (вместо локальной SLM).
# СЮДА ТОЛЬКО ПЛЕЙСХОЛДЕРЫ — живые ключи кладутся в .env (он в .gitignore, в репо не коммитится).
# YandexGPT («Алиса») — primary; GigaChat — fallback при её падении.
# Без ключей/сети — rule-based fallback. Формат GigaChat-ключа: base64(client_id:client_secret).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
#YANDEX_MODEL=yandexgpt-lite
GIGACHAT_API_KEY=

# Адреса ИБ на старте: RoutingRuleSeeder чинит ими только строки с историческим
# сидом V1 (свежая БД с другим MAIL_DOMAIN), ручные правки из /admin не трогает.
# Пусто = infosec@<primary-домен из БД>. Ручное управление — /admin → Адреса ИБ.
ROUTE_TERRORISM=
ROUTE_MAN_MADE=
ROUTE_ILLEGAL=
ROUTE_OTHER=

# JWT для /api/v1/auth (MVP: HS256)
JWT_SECRET=change-me-to-32-chars-minimum-secret
# ВНИМАНИЕ (прод): сгенерируйте длинный случайный секрет, иначе токены подделываются.
# Пример: openssl rand -base64 48

# MVP-админ (создаётся AdminBootstrap при первом старте, логин admin@MAIL_DOMAIN)
APP_ADMIN_PASSWORD=admin
# ВНИМАНИЕ (прод): задайте стойкий пароль, дефолт 'admin' виден в репозитории.

# Хост-порты наружу (если на хосте уже заняты 5432/8080 — переопределить в .env).
# Внутри docker-сети всё ходит по стандартным портам — эти переменные её не касаются.
POSTGRES_HOST_PORT=5432
GATEWAY_HOST_PORT=8080

# Фронт (Next.js): серверный прокси /backend/* -> gateway, публичный домен ящиков
BACKEND_URL=http://gateway:8080
NEXT_PUBLIC_MAIL_DOMAIN=corp-sec.ru

# Nginx TLS-терминация: хост-порты наружу (внутри — 80/443, не трогать).
# Серты: ./nginx/gen-certs.sh (самоподпись OpenSSL), в репо не коммитятся.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443