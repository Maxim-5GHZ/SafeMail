# Домен своих ящиков. Регистрация username+password -> username@MAIL_DOMAIN
MAIL_DOMAIN=corp-sec.ru

# PostgreSQL
POSTGRES_DB=safemail
POSTGRES_USER=safemail
POSTGRES_PASSWORD=safemail
DATABASE_URL=jdbc:postgresql://postgres:5432/safemail

# Порты SMTP-шлюза (внутри контейнера gateway)
SMTP_PORT=2525
SMTP_HOST=0.0.0.0
# Внешняя отправка (relay). Для MVP — MailHog-подобный фейк или реальный relay
MAIL_RELAY_HOST=mailhog
MAIL_RELAY_PORT=1025

# Python-микросервисы (внутри docker-сети)
PARSER_URL=http://ml-parser:8001
ENRICH_URL=http://ml-enrich:8002
CLASSIFY_URL=http://ml-classify:8003

# Куда перенаправлять угрозы по умолчанию (перекрывается таблицей threat_routing_rules)
ROUTE_TERRORISM=infosec@corp-sec.ru
ROUTE_MAN_MADE=infosec@corp-sec.ru
ROUTE_ILLEGAL=infosec@corp-sec.ru
ROUTE_OTHER=infosec@corp-sec.ru

# JWT для /api/v1/auth (MVP: HS256)
JWT_SECRET=change-me-to-32-chars-minimum-secret

# Хост-порты наружу (если на хосте уже заняты 5432/8080 — переопределить в .env).
# Внутри docker-сети всё ходит по стандартным портам — эти переменные её не касаются.
POSTGRES_HOST_PORT=5432
GATEWAY_HOST_PORT=8080

# Фронт (Next.js): серверный прокси /backend/* -> gateway, публичный домен ящиков
BACKEND_URL=http://gateway:8080
NEXT_PUBLIC_MAIL_DOMAIN=corp-sec.ru

# Nginx TLS-терминация: хост-порты наружу (внутри — 80/443, не трогать).
# Серты: ./nginx/gen-certs.sh (самоподпись OpenSSL), в репо не коммитятся.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
